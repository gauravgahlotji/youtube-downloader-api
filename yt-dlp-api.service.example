[Unit]
Description=Enterprise YouTube Downloader API Engine
After=network.target

[Service]
User=root
WorkingDirectory=/opt/yt-dlp-api
Environment="PATH=/opt/yt-dlp-api/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/opt/yt-dlp-api/.venv/bin/gunicorn -w 4 -k uvicorn.workers.UvicornWorker main:app --bind 127.0.0.1:8000 --timeout 600
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
